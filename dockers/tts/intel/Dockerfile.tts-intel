# Dockerfile for the Kokoro TTS service (project_code/audio/tts_service.py)
# Intel / CPU-only variant - no CUDA/NVIDIA runtime required.
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    TTS_DEVICE=cpu \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/app/.cache/huggingface

WORKDIR /app

# System dependencies required by kokoro / phonemizer (espeak-ng) and audio libs.
RUN apt-get update && apt-get install -y --no-install-recommends \
        espeak-ng \
        libsndfile1 \
        git \
        curl \
    && rm -rf /var/lib/apt/lists/*

# CPU-only torch build (no CUDA), plus Intel Extension for PyTorch for extra
# CPU acceleration on Intel hardware.
RUN pip install --upgrade pip && \
    pip install torch --index-url https://download.pytorch.org/whl/cpu && \
    pip install intel-extension-for-pytorch

# Python dependencies for the service itself.
RUN pip install \
        fastapi \
        uvicorn[standard] \
        pydantic \
        numpy \
        kokoro

# Pre-download the Kokoro model weights/config AND the voice pack(s) used by
# tts_service.py at BUILD time (network access is available during build).
# Voice packs (e.g. 'am_adam') are lazily downloaded from the Hub on first
# use, not when KPipeline() is constructed, so we run one real synthesis to
# force that download too. This avoids a runtime dependency on
# huggingface.co, which can be unreachable / flaky from inside the running
# container (docker-compose network, offline host, corporate proxy, etc.)
# and previously caused: "RuntimeError: Cannot send a request, as the client
# has been closed" / "cannot find the requested files in the local cache".
RUN python -c "\
from kokoro import KPipeline; \
p = KPipeline(lang_code='a', device='cpu'); \
list(p('warmup', voice='am_adam'))"

# Force fully offline mode at runtime: never attempt network calls to the
# HuggingFace Hub, always use the cache populated above.
ENV HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1

# Copy only what's needed to run the TTS service.
COPY project_code/audio/tts_service.py /app/project_code/audio/tts_service.py
RUN mkdir -p /app/project_code/audio && touch /app/project_code/__init__.py /app/project_code/audio/__init__.py

EXPOSE 8002

CMD ["python", "project_code/audio/tts_service.py"]

