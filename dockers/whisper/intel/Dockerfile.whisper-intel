# Dockerfile for the faster-whisper STT service (project_code/audio/whisper_service.py)
# NVIDIA GPU variant - requires the NVIDIA Container Toolkit + a compatible
# driver on the host (whisper_service.py hardcodes device="cuda").
FROM nvidia/cuda:12.2.2-cudnn8-runtime-ubuntu22.04

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive \
    STT_DEVICE=cuda \
    STT_COMPUTE_TYPE=float16

WORKDIR /app

# System dependencies:
#   - python3/pip: this base image has no Python by default
#   - libsndfile1/ffmpeg: needed by faster-whisper / audio decoding backends
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        libsndfile1 \
        ffmpeg \
        git \
        curl \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3 /usr/bin/python

# CUDA-enabled torch build (compatible with the CUDA 12.2 runtime above).
RUN pip install --upgrade pip && \
    pip install torch --index-url https://download.pytorch.org/whl/cu121

# Python dependencies for the service itself.
RUN pip install \
        fastapi \
        uvicorn[standard] \
        pydantic \
        pyyaml \
        numpy \
        python-multipart \
        faster-whisper \
        huggingface_hub

# Bake the faster-whisper model weights into the image as a flat local
# directory (using huggingface_hub's `local_dir`, not `cache_dir`). This
# matters because whisper_service.py (on x86_64) passes the model *name*
# ("large-v3-turbo", from conf.yaml) straight to WhisperModel(). At runtime
# faster-whisper only skips the Hugging Face download when
# os.path.isdir(model_size_or_path) is True - a HF "cache_dir" layout
# (blobs/snapshots/refs) is NOT a plain model dir, so at runtime it was still
# calling huggingface_hub.snapshot_download(), which requires network access
# and failed inside the container with IncompleteSnapshotError. Downloading
# to a flat `local_dir` avoids that entirely, and conf.yaml below is patched
# to point model_size at this local directory so no network call happens at
# all when the container starts.
ENV WHISPER_MODEL_DIR=/app/models/faster-whisper-large-v3-turbo
RUN python3 -c "\
from huggingface_hub import snapshot_download; \
snapshot_download(repo_id='mobiuslabsgmbh/faster-whisper-large-v3-turbo', revision='0a363e9161cbc7ed1431c9597a8ceaf0c4f78fcf', local_dir='${WHISPER_MODEL_DIR}')"

# Application code.
COPY project_code /app/project_code

# app_config/settings.py is imported as a top-level package
# ("from app_config.settings import app_settings", see whisper_service.py),
# resolved relative to the process's working directory / sys.path (/app), so
# copy the root app_config package (settings.py + conf.yaml) here too.
COPY app_config/settings.py /app/app_config/settings.py
COPY app_config/conf.yaml /app/app_config/conf.yaml

# Point conf.yaml's stt.model_size at the local, baked-in model directory
# instead of the bare "large-v3-turbo" name, so whisper_service.py's
# `model_path = app_settings.audio.stt.model_size` (x86_64 branch) resolves
# to an existing directory and faster-whisper loads it directly, without
# ever attempting a Hugging Face Hub lookup at container startup.
RUN sed -i "s|model_size: .*|model_size: ${WHISPER_MODEL_DIR}|" /app/app_config/conf.yaml

EXPOSE 8013

CMD ["python3", "-m", "project_code.audio.whisper_service"]

